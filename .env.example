# Copie este arquivo para ".env" (peça ao Claude: "crie o .env a partir do .env.example").
# O .env NUNCA vai para o Git e o token NUNCA aparece na tela do navegador.
# Mudou algo aqui? Rode "make up" de novo (Windows: clique duas vezes em iniciar.bat)
# para o sistema ler os valores novos.

# Token da Twygo (cole no lugar do texto de exemplo, sem espaços nem aspas).
TWYGO_API_TOKEN=cole_o_token_do_workshop_aqui
TWYGO_API_BASE_URL=https://api.twygo.com

# Banco de dados local (pode deixar como está).
# Se mudar depois de já ter ligado o sistema, rode "make reset" (Windows: resetar.bat;
# apaga o banco local).
POSTGRES_USER=workshop
POSTGRES_PASSWORD=workshop
POSTGRES_DB=workshop

# Portas no seu computador (só mude se a 5193 ou a 5194 já estiver em uso).
# Depois de mudar, rode "make up" (Windows: iniciar.bat) de novo.
# FRONTEND_PORT=5193
# BACKEND_PORT=5194
