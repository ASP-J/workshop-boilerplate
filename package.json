{
  "name": "twygo-boilerplate-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Esqueleto pronto para o desafio do seu setor no Workshop de IA da Twygo. Roda só no seu computador.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,tela -c magenta,yellow \"npm:server\" \"npm:client\"",
    "client": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "server": "node server/index.js",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 5193"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "recharts": "^3.10.1",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
